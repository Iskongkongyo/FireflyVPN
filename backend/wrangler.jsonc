{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "firefly-vpn-edge",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-11",
    "workers_dev": true,
    "triggers": {
        "crons": [
            "17 * * * *"
        ]
    },
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
    },
    "vars": {
        "APP_ENV": "development",
        "ADMIN_ROUTE": "后端管理页面访问路径"
    },
    "kv_namespaces": [
        {
            "binding": "CONFIG",
            "id": "填写CONFIG对应的ID"
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "firefly-vpn-edge",
            "database_id": "填写DB对应的ID",
            "migrations_dir": "database/migrations"
        }
    ],
    "ratelimits": [
        {
            "name": "DEVICE_ENROLL_IP_RATE_LIMITER",
            "namespace_id": "202132001",
            "simple": { "limit": 30, "period": 60 }
        },
        {
            "name": "DEVICE_ENROLL_DEVICE_RATE_LIMITER",
            "namespace_id": "202132002",
            "simple": { "limit": 6, "period": 60 }
        },
        {
            "name": "SUBSCRIPTION_DEVICE_RATE_LIMITER",
            "namespace_id": "202132003",
            "simple": { "limit": 60, "period": 60 }
        },
        {
            "name": "ROTATE_DEVICE_RATE_LIMITER",
            "namespace_id": "202132004",
            "simple": { "limit": 3, "period": 60 }
        }
    ]
}

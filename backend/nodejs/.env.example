HOST=127.0.0.1
PORT=3000
APP_ENV=production

# Use unique random values in production. ADMIN_ROUTE must be 8-128 URL-safe characters.
ADMIN_ROUTE=replace-with-a-private-admin-path
ADMIN_TOKEN=replace-with-a-strong-admin-token

# Relative paths are resolved from APP_ROOT (the current working directory by default).
DB_PATH=./data/firefly.sqlite
MIGRATIONS_DIR=./database/migrations
PUBLIC_DIR=./public

# Enable only when every request reaches Node through a trusted reverse proxy
# that replaces X-Forwarded-For (for example, the nginx config in deploy/).
TRUST_PROXY=false

